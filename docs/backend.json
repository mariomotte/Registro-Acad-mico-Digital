{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["Administrador", "Director", "Subdirector", "Docente", "Auxiliar"]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Student": {
      "title": "Student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombres": { "type": "string" },
        "apellidos": { "type": "string" },
        "grado": { "type": "string" },
        "seccion": { "type": "string" },
        "estado": { "type": "string", "enum": ["Activo", "Inactivo", "Suspendido"] }
      }
    },
    "Incidence": {
      "title": "Incidence",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "alumnoId": { "type": "string" },
        "tipo": { "type": "string" },
        "descripcion": { "type": "string" },
        "severidad": { "type": "string", "enum": ["bajo", "medio", "alto"] },
        "fecha": { "type": "string", "format": "date-time" },
        "registradoPor": { "type": "string" },
        "registradorUserId": { "type": "string" }
      }
    },
    "Alert": {
      "title": "Alert",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "alumnoId": { "type": "string" },
        "alumnoNombre": { "type": "string" },
        "tipo": { "type": "string" },
        "nivel": { "type": "string", "enum": ["verde", "amarillo", "rojo"] },
        "mensaje": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" },
        "leido": { "type": "boolean" },
        "accionRequerida": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "supabase": {
    "tables": {
      "users": { "schema": "User", "description": "User profiles" },
      "alumnos": { "schema": "Student", "description": "Student records" },
      "incidencias": { "schema": "Incidence", "description": "Incident reports" },
      "alertas": { "schema": "Alert", "description": "System alerts" }
    }
  }
}
